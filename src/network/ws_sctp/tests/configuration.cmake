# Run with: cmake -P src/network/ws_sctp/tests/configuration.cmake
# This checks feature selection without configuring or compiling a target.
cmake_minimum_required(VERSION 3.16)
get_filename_component(project_root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(CMAKE_SYSTEM_NAME Emscripten)
set(CMAKE_CURRENT_SOURCE_DIR "${project_root}/src")
if(MISSING_SOURCE)
    set(CMAKE_CURRENT_SOURCE_DIR "${project_root}/src/network/ws_sctp/tests/missing")
endif()
set(USE_MULTI OFF)
set(ENABLE_WEBSOCKET OFF)
set(ENABLE_ENET OFF)
set(ENABLE_SCTP OFF)
macro(target_link_options target scope option)
    if(NOT "${option}" STREQUAL "-lwebsocket.js")
        message(FATAL_ERROR "Unexpected browser link option: ${option}")
    endif()
    set(websocket_linked TRUE)
endmacro()
macro(target_compile_definitions)
endmacro()
macro(add_subdirectory)
    if(sctp_inet OR sctp_inet6)
        message(FATAL_ERROR "Browser SCTP must use AF_CONN only")
    endif()
    set_property(GLOBAL PROPERTY browser_sctp_added TRUE)
endmacro()
include("${project_root}/cmake/Modules/fm_network.cmake")
get_property(stack_added GLOBAL PROPERTY browser_sctp_added)
if(MISSING_SOURCE)
    if(USE_WEBSOCKET_SCTP OR USE_SCTP OR websocket_linked OR stack_added)
        message(FATAL_ERROR "Missing stack incorrectly enabled SCTP")
    endif()
elseif(NOT USE_WEBSOCKET_SCTP OR NOT USE_SCTP OR NOT websocket_linked OR NOT stack_added)
    message(FATAL_ERROR "Browser SCTP carrier was not enabled")
endif()
if(USE_WEBSOCKET OR USE_CLIENT_MCP)
    message(FATAL_ERROR "Browser SCTP must not pull in WebSocket++ or MCP")
endif()
message(STATUS "Browser SCTP configuration checks passed")
