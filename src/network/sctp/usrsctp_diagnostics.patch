@@ -42,6 +42,30 @@
 #include <netinet/sctp_asconf.h>
 #include <netinet/sctp_timer.h>
 
+#if defined(__linux__) && !defined(__EMSCRIPTEN__) && (defined(INET) || defined(INET6))
+/* fm: Focused ASCONF diagnostics, independent of SCTP_DEBUG. */
+extern void sctp_diagnostic(int warning, const char *message);
+static void sctp_asconf_diagnostic(struct sctp_tcb *stcb,
+    const char *event, uint32_t parameter, uint32_t error)
+{
+	char message[192];
+	const char *operation = parameter == SCTP_ADD_IP_ADDRESS ? "ADD" :
+	    parameter == SCTP_DEL_IP_ADDRESS ? "DELETE" :
+	    parameter == SCTP_SET_PRIM_ADDR ? "PRIMARY" : "OTHER";
+	snprintf(message, sizeof(message),
+	    "ASCONF %s assoc=%u expected_ack=%u operation=%s parameter=%u cause=%u",
+	    event, (unsigned)stcb->asoc.assoc_id,
+	    (unsigned)(stcb->asoc.asconf_seq_out_acked + 1),
+	    operation, (unsigned)parameter, (unsigned)error);
+	sctp_diagnostic(error != 0 || strcmp(event, "operation failed") == 0, message);
+}
+#define SCTP_ASCONF_LOG(stcb, event, parameter, error) \
+    sctp_asconf_diagnostic(stcb, event, parameter, error)
+#else
+#define SCTP_ASCONF_LOG(stcb, event, parameter, error) ((void)0)
+#endif
+
+
