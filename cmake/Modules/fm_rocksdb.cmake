option(ENABLE_ROCKSDB "Enable RocksDB backend when available" ON)
set(USE_ROCKSDB FALSE)
if(ENABLE_ROCKSDB)
    find_path(ROCKSDB_INCLUDE_DIR NAMES rocksdb/db.h)
    find_library(ROCKSDB_LIBRARY NAMES rocksdb)
    if(ROCKSDB_INCLUDE_DIR AND ROCKSDB_LIBRARY)
        set(USE_ROCKSDB TRUE)
        include_directories(SYSTEM ${ROCKSDB_INCLUDE_DIR})
        message(STATUS "Using system RocksDB: ${ROCKSDB_LIBRARY}")
    elseif(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/external/rocksdb/CMakeLists.txt" AND
            EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/external/rocksdb/include/rocksdb/db.h")
        set(WITH_TESTS OFF)
        set(WITH_BENCHMARK_TOOLS OFF)
        set(WITH_CORE_TOOLS OFF)
        set(WITH_TOOLS OFF)
        set(WITH_TRACE_TOOLS OFF)
        set(WITH_GFLAGS OFF)
        set(WITH_LIBURING OFF)
        set(ROCKSDB_BUILD_SHARED OFF)
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        add_subdirectory(external/rocksdb EXCLUDE_FROM_ALL)
        set_target_properties(rocksdb PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
        set(ROCKSDB_LIBRARY rocksdb)
        include_directories(SYSTEM ${CMAKE_CURRENT_SOURCE_DIR}/external/rocksdb/include)
        set(USE_ROCKSDB TRUE)
        message(STATUS "Using bundled RocksDB")
    else()
        message(STATUS "RocksDB not found; backend disabled")
    endif()
endif()
